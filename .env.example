# docker-compose.prod.yml icin ornek yapilandirma.
#
#   cp .env.example .env
#
# .env dosyasi ASLA commit'lenmez (bkz. .gitignore).

# --- Veritabani ---
DB_NAME=company_ai_assistant
DB_USERNAME=app_user
# Gelistirmedeki "app_password" DEGISTIRILMELI.
DB_PASSWORD=

# --- Guvenlik ---
# En az 32 bayt olmali (application.yml'deki dev varsayilaninin uzunlugu bu yuzden).
# Uretmek icin (kriptografik olarak guvenli kaynak kullanilmali, Get-Random DEGIL):
#   Linux/macOS : openssl rand -base64 48
#   PowerShell  : $b = New-Object byte[] 48
#                 [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#                 [Convert]::ToBase64String($b)
JWT_SECRET=

# --- Opsiyonel ---
# Bos birakilirsa compose varsayilanlari kullanilir.
OLLAMA_EMBEDDING_MODEL=bge-m3
# Nominatim kullanim sartlari tanimlanabilir bir User-Agent istiyor.
GEOCODING_USER_AGENT=company-assistant-api/1.0
